{
  "manifest_version": 3,
  "name": "Autofilljobs",
  "description": "Automatically fill job application forms using AI",
  "version": "1.0.3",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Autofilljobs",
    "default_icon": "icon.png"
  },
  "permissions": [
    "activeTab",
    "identity",
    "identity.email",
    "background",
    "storage",
    "tabs",
    "scripting",
    "webRequest",
    "notifications",
    "contextMenus"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "contentScript.js"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>",
    "*://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "variablepopup.html",
        "variablepopup.js",
        "assets/Tom_George.pdf",
        "src/assets/settings.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "edge": {
      "edge_addons_id": "your-edge-addon-id-here"
    }
  }
}