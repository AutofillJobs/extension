{
  "manifest_version": 3,
  "name": "Autofill, job tracker - applyGOAT",
  "description": "Autofill job application forms using AI",
  "version": "2.1.6",
  "action": {
    "default_popup": "popup.html",
    "default_title": "applyGOAT",
    "default_icon": "icon.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "cookies"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://applygoat.com/*",
        "https://*.applygoat.com/*",
        "*://*/*",
        "*://*.indeed.com/*",
        "*://smartapply.indeed.com/*",
        "*://*.smartapply.indeed.com/*"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "*://*/*",
    "http://localhost:*/*",
    "https://localhost:*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "homepage_url": "https://applygoat.com/"
}