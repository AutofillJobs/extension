{
  "manifest_version": 3,
  "name": "applyGOAT",
  "description": "Autofill job application forms using AI",
  "version": "2.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "applyGOAT",
    "default_icon": "icon.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "webRequest",
    "tabs"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "contentScript.js"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>",
    "*://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/assets/settings.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}